{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "enabledManagers": ["npm"],
  "rangeStrategy": "replace",
  "timezone": "Europe/Warsaw",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "mode": "full",
  "prCreation": "auto",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Production dependencies – separate majors",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "major prod dependencies",
      "commitMessagePrefix": "fix: ",
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Production dependencies – group minor and patch",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch prod dependencies",
      "commitMessagePrefix": "fix: ",
      "labels": ["dependencies", "minor/patch"]
    },
    {
      "description": "Dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "commitMessagePrefix": "chore: ",
      "labels": ["dev-dependency"]
    },
    {
      "description": "Lockfile maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "lockfile maintenance",
      "commitMessagePrefix": "chore: ",
      "labels": ["lockfile"]
    },
    {
      "description": "Hold OG image rendering: satori 0.33+ throws `__dirname is not defined` in the Nitro prerender (vercel/satori#844), and newer nuxt-og-image requires it. Lift once that is fixed.",
      "matchPackageNames": ["satori"],
      "allowedVersions": "<0.33.0"
    },
    {
      "description": "Hold nuxt-og-image on 6.5 with satori, see the rule above.",
      "matchPackageNames": ["nuxt-og-image"],
      "allowedVersions": "<6.6.0"
    },
    {
      "description": "Hold TypeScript 6: vue-tsc (nuxt typecheck) cannot load TypeScript 7 yet (vuejs/language-tools#6170). Lift once vue-tsc supports it.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Hold the mdast-util-to-markdown override in pnpm-workspace.yaml: 2.1.3 and later overflow the stack in remark-mdc 3.11.1's strong handler and /llms-full.txt fails to prerender. Lift once a clean build renders it.",
      "matchPackageNames": ["mdast-util-to-markdown"],
      "allowedVersions": "<=2.1.2"
    }
  ]
}